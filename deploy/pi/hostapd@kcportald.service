# hostapd@kcportald.service — Wi-Fi AP as a template unit so the daemon
# and the operator can restart it independently of kcportald. kcportald
# renders /run/kcportal/hostapd.conf and restarts this unit itself when
# the rendered config drifts (polkit rule deploy/pi/10-kcportal-restart.rules
# pins the privilege to exactly this unit + dnsmasq-kcp, verb restart); a
# manual `systemctl restart hostapd@kcportald` stays equivalent.
#
# The config lives in tmpfs (/run/hostapd) and is regenerated by
# kcportald at every boot BEFORE this unit starts (Requires=/After=
# below) — no PSK ever touches the SD card (§7.3, PD-4).

[Unit]
Description=hostapd for KotaCloud Portal (rendered config)
Requisite=kcportald.service
After=kcportald.service
PartOf=kcportald.service
[Service]
Type=simple
# Fail-then-retry until kcportald has rendered the config (startup order
# race): Restart=below turns a missing file into a clean retry loop.
# Config path matches kcportald's -nft-dir (tmpfs, PD-4).
ExecStartPre=/bin/sh -c 'test -f /run/kcportal/hostapd.conf'
ExecStart=/usr/sbin/hostapd /run/kcportal/hostapd.conf
Restart=always
RestartSec=2

# Full root, exactly like the distro's hostapd.service: hostapd needs
# nl80211 radio programming (CAP_NET_ADMIN), bridge attachment, and it
# mkdir/chown's its ctrl_interface socket — a trimmed bounding set
# turns each of those into EPERM whack-a-mole (mkdir, then lchown, ...
# observed on trixie). The rendered config it reads lives on tmpfs and
# the machine is a dedicated captive-portal appliance; hardening for
# hostapd itself is deferred to an M3+ sandboxing pass.

[Install]
WantedBy=multi-user.target
