ctrl_interface=/run/hostapd
ctrl_interface_group=kcportal
country_code=ID
ieee80211d=1
interface=wlan0
driver=nl80211
hw_mode=a
channel=36
ieee80211n=1
ieee80211ac=1
vht_oper_chwidth=1
vht_oper_centr_freq_seg0_idx=42
wmm_enabled=1
max_num_sta=16
ap_max_inactivity=300
disassoc_low_ack=1

# BSS0 — Staff (Bouncer: enforce) -> br-lan
ssid=Kafe-Staff
bridge=br-lan
ap_isolate=1
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=secrets-injected-psk

# BSS1 — Guest (Bouncer: portal) -> br-guest   (DD-01)
bss=wlan0_1
ssid=Kafe-WiFi
bridge=br-guest
ap_isolate=1
wpa=0
ignore_broadcast_ssid=1
