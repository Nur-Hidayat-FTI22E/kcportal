user=dnsmasq
bind-dynamic
interface=br-lan
interface=br-guest
no-resolv
server=1.1.1.1
server=9.9.9.9
cache-size=1000
domain-needed
bogus-priv
stop-dns-rebind
rebind-localhost-ok
local=/kcp.internal/
address=/admin.kcp.internal/192.168.50.1
address=/portal.kcp.internal/10.20.3.1
address=/pos.kcp.internal/10.20.2.1
address=/waiting.kcp.internal/10.20.99.1

dhcp-authoritative
dhcp-leasefile=/run/kcportal/dnsmasq/leases
dhcp-hostsdir=/run/kcportal/dnsmasq/hosts.d
dhcp-script=/usr/lib/kcportal/dhcp-hook

# pool waiting on br-lan
dhcp-range=set:waiting,10.20.99.10,10.20.99.250,255.255.255.0,120s
dhcp-option=tag:waiting,option:router,10.20.99.1
dhcp-option=tag:waiting,option:dns-server,10.20.99.1

# pool z1 on br-lan
dhcp-range=set:z1,192.168.50.0,static,255.255.255.0,12h
dhcp-option=tag:z1,option:router,192.168.50.1
dhcp-option=tag:z1,option:dns-server,192.168.50.1

# pool z2 on br-lan
dhcp-range=set:z2,10.20.2.0,static,255.255.255.0,12h
dhcp-option=tag:z2,option:router,10.20.2.1
dhcp-option=tag:z2,option:dns-server,10.20.2.1

# pool guest on br-guest
dhcp-range=set:guest,10.20.3.20,10.20.3.250,255.255.255.0,2h
dhcp-option=tag:guest,option:router,10.20.3.1
dhcp-option=tag:guest,option:dns-server,10.20.3.1

# HANYA bila sertifikat publik tersedia (DD-09/T2; ERR-07):
# dhcp-option=tag:guest,114,"https://portal.kcp.internal/portal/api/v1/captive"
